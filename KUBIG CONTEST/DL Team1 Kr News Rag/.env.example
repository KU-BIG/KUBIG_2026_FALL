# 답변 생성·질의 확장·검색 게이트가 어떤 프로바이더를 쓸지.
# anthropic | openai | openrouter (기본값: anthropic)
LLM_PROVIDER=anthropic

# --- Anthropic ---
# (do NOT commit a real key)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-5

# --- OpenAI ---
# 답변 생성용으로 쓸 때(LLM_PROVIDER=openai)와 blind retrieval adjudication에서
# 같은 키를 씁니다. 모델 기본값은 없습니다.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=
# 호환 게이트웨이를 쓸 때만 지정합니다. 비워두면 OpenAI 기본 주소를 씁니다.
OPENAI_BASE_URL=
#
# adjudication은 OPENAI_MODEL을 보지 않습니다. evaluation/cli.py 의 _judge_llm 이
# smoke test를 통과한 모델을 직접 지정하므로, 여기를 바꿔도 동결된 평가 결과의
# 재현성은 영향받지 않습니다.

# --- OpenRouter ---
# LLM_PROVIDER=openrouter 일 때만 필요합니다. base_url은 코드에 고정돼 있습니다.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
